@page "/"
@layout Layout.SiteLayout
@using RotationDating.Web.Services
@inject SiteContentService SiteContent

<PageTitle>SSF 싱싱한팜</PageTitle>

<section class="ssf-hero" id="top" aria-label="메인 비주얼">
    <div class="ssf-hero-media" style="--hero-image:url('@SiteContentSnapshot.CssUrl(_site.Get(SiteContentKeys.HeroImage))')"></div>
    <div class="ssf-hero-overlay"></div>
    <div class="ssf-hero-content">
        <h1 class="ssf-hero-title">@_site.Get(SiteContentKeys.HeroTitle)</h1>
        <span class="ssf-hero-line" aria-hidden="true"></span>
        <p class="ssf-hero-desc">@_site.Get(SiteContentKeys.HeroDesc)</p>
    </div>
</section>

@for (var i = 0; i < _site.Sections.Count; i++)
{
    var block = _site.Sections[i];
    var isAlt = i % 2 == 1;
    <section class="ssf-split-section @(isAlt ? "ssf-split-alt" : "")">
        <div class="ssf-container">
            <h2 class="ssf-serif-heading">@block.Heading</h2>
            <div class="ssf-split-layout @(block.IsReversed ? "ssf-split-reverse" : "")">
                @if (!block.IsReversed)
                {
                    <div class="ssf-photo-pair">
                        <div class="ssf-photo" style="--photo:url('@SiteContentSnapshot.CssUrl(block.ImageUrl1)')" role="img" aria-label="@block.ImageAlt1"></div>
                        <div class="ssf-photo" style="--photo:url('@SiteContentSnapshot.CssUrl(block.ImageUrl2)')" role="img" aria-label="@block.ImageAlt2"></div>
                    </div>
                }
                <div class="ssf-split-copy">
                    <h3>@block.Title</h3>
                    <span class="ssf-accent-line" aria-hidden="true"></span>
                    <p>@block.Body</p>
                </div>
                @if (block.IsReversed)
                {
                    <div class="ssf-photo-pair">
                        <div class="ssf-photo" style="--photo:url('@SiteContentSnapshot.CssUrl(block.ImageUrl1)')" role="img" aria-label="@block.ImageAlt1"></div>
                        <div class="ssf-photo" style="--photo:url('@SiteContentSnapshot.CssUrl(block.ImageUrl2)')" role="img" aria-label="@block.ImageAlt2"></div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="ssf-intro" id="home-intro">
    <div class="ssf-container ssf-intro-inner">
        <div class="ssf-intro-brand">
            <span class="ssf-intro-en">SSF</span>
            <span class="ssf-intro-ko">싱싱한 팜</span>
        </div>
        <p class="ssf-intro-notice">
            @_site.Get(SiteContentKeys.IntroNotice)
            @if (!string.IsNullOrWhiteSpace(_site.Get(SiteContentKeys.IntroNoticeEn)))
            {
                <span lang="en">@_site.Get(SiteContentKeys.IntroNoticeEn)</span>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(_kakaoUrl))
        {
            <div class="ssf-intro-actions">
                <a href="@_kakaoUrl" class="ssf-btn ssf-btn-dark" target="_blank" rel="noopener noreferrer">
                    <svg class="ssf-btn-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5c-4.6 0-8.3 2.9-8.3 6.5 0 2.3 1.5 4.3 3.8 5.5l-.9 3.3 3.7-2c.5.1 1.1.2 1.7.2 4.6 0 8.3-2.9 8.3-6.5S16.6 4.5 12 4.5Z" fill="currentColor" stroke="none"/></svg>
                    카카오톡
                </a>
            </div>
        }
    </div>
</section>

@if (_site.FeatureCards.Count > 0)
{
    <section class="ssf-feature-cards">
        <div class="ssf-container ssf-feature-grid">
            @foreach (var card in _site.FeatureCards)
            {
                <a href="@card.LinkUrl"
                   class="ssf-feature-card @(card.Variant == "class" ? "ssf-feature-class" : "ssf-feature-store")"
                   target="_blank"
                   rel="noopener noreferrer"
                   style="--card-image:url('@SiteContentSnapshot.CssUrl(card.ImageUrl)')">
                    <div class="ssf-feature-copy">
                        <p class="ssf-feature-eyebrow">@card.Eyebrow</p>
                        <h2 class="ssf-feature-title">@card.Title</h2>
                        <span class="ssf-pill">@card.Pill</span>
                    </div>
                </a>
            }
        </div>
    </section>
}

@if (_site.GalleryItems.Count > 0)
{
    <section class="ssf-gallery" id="gallery">
        <div class="ssf-container">
            <div class="ssf-gallery-tabs" role="tablist" aria-label="갤러리 분류" data-ssf-gallery-tabs>
                @foreach (var tab in _site.GalleryTabs)
                {
                    <button type="button"
                            class="ssf-gallery-tab @(tab == "전체" ? "is-active" : "")"
                            data-ssf-gallery-tab="@tab"
                            role="tab">@tab</button>
                }
            </div>
            <div class="ssf-gallery-grid" data-ssf-gallery-grid>
                @foreach (var item in _site.GalleryItems)
                {
                    <article class="ssf-gallery-item" data-ssf-gallery-cat="@item.Category">
                        <div class="ssf-gallery-thumb" style="--thumb:url('@SiteContentSnapshot.CssUrl(item.ImageUrl)')"></div>
                        <p class="ssf-gallery-caption">@item.Caption</p>
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (_site.Posts.Count > 0)
{
    <section class="ssf-news" id="news">
        <div class="ssf-container">
            <h2 class="ssf-serif-heading">소식</h2>
            <div class="ssf-news-list">
                @foreach (var post in _site.Posts)
                {
                    <article class="ssf-news-card">
                        @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                        {
                            <div class="ssf-news-thumb" style="--thumb:url('@SiteContentSnapshot.CssUrl(post.ImageUrl)')"></div>
                        }
                        <div class="ssf-news-copy">
                            <p class="ssf-news-date">@post.CreatedAt.ToString("yyyy.MM.dd")</p>
                            <h3>@post.Title</h3>
                            <p>@post.Body</p>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (_site.FaqItems.Count > 0)
{
    <section class="ssf-faq" id="faq">
        <div class="ssf-container">
            <h2 class="ssf-serif-heading ssf-faq-heading">FAQ</h2>
            <div class="ssf-faq-list" data-ssf-faq>
                @foreach (var item in _site.FaqItems)
                {
                    <details class="ssf-faq-card">
                        <summary>
                            <span>@item.Question</span>
                            <span class="ssf-faq-chevron" aria-hidden="true"></span>
                        </summary>
                        <div class="ssf-faq-body">
                            @item.Answer
                        </div>
                    </details>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_kakaoUrl))
            {
                <div class="ssf-faq-write">
                    <a href="@_kakaoUrl" class="ssf-write-btn" target="_blank" rel="noopener noreferrer">문의하기</a>
                </div>
            }
        </div>
    </section>
}

<section class="ssf-event-banner">
    <div class="ssf-container ssf-event-inner">
        <p class="ssf-event-eyebrow">@_site.Get(SiteContentKeys.EventEyebrow)</p>
        <h2 class="ssf-event-title">@_site.Get(SiteContentKeys.EventTitle)</h2>
        <p class="ssf-event-desc">@_site.Get(SiteContentKeys.EventDesc)</p>
        <a href="/login" class="ssf-btn ssf-btn-outline-light">행사 참가 로그인</a>
    </div>
</section>

@code {
    private SiteContentSnapshot _site = SiteContentSnapshot.Empty;
    private string _kakaoUrl = "";

    protected override async Task OnInitializedAsync()
    {
        _site = await SiteContent.GetAsync();
        _kakaoUrl = _site.Get(SiteContentKeys.KakaoUrl);
    }
}
