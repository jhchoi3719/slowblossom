@page "/love/match"
@layout Layout.LoveLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@inject AssetVersion Assets

<PageTitle>MBTI 연애 궁합 테스트 · 슬로우블러썸</PageTitle>
<HeadContent>
    <meta name="description" content="나와 그 사람의 이름과 MBTI로 보는 연애 궁합 점수, 연애 스타일, 관계를 위한 노력 2가지" />
    <meta property="og:title" content="MBTI 연애 궁합 테스트 · 슬로우블러썸" />
    <meta property="og:description" content="이름과 MBTI만 넣으면 두 사람의 궁합 점수와 연애 스타일을 알려드려요." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&display=swap" />
    <link rel="stylesheet" href="@Assets.Url("love.css")" />
</HeadContent>

<div class="love">
    <header class="love-top">
        <a href="/love" class="love-brand">SLOW BLOSSOM</a>
        <a href="https://www.instagram.com/slowblossom.daegu/" class="love-insta" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
            </svg>
            <span>@@slowblossom.daegu</span>
        </a>
    </header>

    <main class="match">
        <section class="love-hero match-hero">
            <p class="love-eyebrow">MBTI 연애 궁합</p>
            <h1>우리 둘,<br />얼마나 잘 맞을까?</h1>
            <p class="love-lead">이름과 MBTI만 넣으면 두 사람의 궁합 점수와 연애 스타일, 관계를 위해 해 볼 노력 2가지를 알려드려요.</p>
        </section>

        <form id="match-form" class="match-card match-form" novalidate>
            <div class="match-progress" aria-hidden="true"><span></span></div>

            <div class="match-step" data-step="0">
                <p class="match-q-no">1 / 5</p>
                <h2>당신의 이름은?</h2>
                <input name="me" maxlength="10" required autocomplete="off" placeholder="예: 효정" aria-label="내 이름" />
                <button type="button" class="love-cta match-next">다음 <span aria-hidden="true">→</span></button>
            </div>

            <div class="match-step" data-step="1" hidden>
                <p class="match-q-no">2 / 5</p>
                <h2><span data-name="me"></span>님의 MBTI는?</h2>
                <div class="match-types">@TypeRadios("myType")</div>
            </div>

            <div class="match-step" data-step="2" hidden>
                <p class="match-q-no">3 / 5</p>
                <h2>궁합이 궁금한 그 사람의 이름은?</h2>
                <input name="you" maxlength="10" required autocomplete="off" placeholder="예: 민수" aria-label="그 사람 이름" />
                <button type="button" class="love-cta match-next">다음 <span aria-hidden="true">→</span></button>
            </div>

            <div class="match-step" data-step="3" hidden>
                <p class="match-q-no">4 / 5</p>
                <h2><span data-name="you"></span>님의 MBTI는?</h2>
                <div class="match-types">@TypeRadios("yourType")</div>
            </div>

            <div class="match-step" data-step="4" hidden>
                <p class="match-q-no">5 / 5</p>
                <h2>지금 두 사람은<br />어떤 사이예요?</h2>
                <div class="match-stages">
                    <label><input type="radio" name="stage" value="before" /><span><b>아직 잘 모르는 사이</b><small>곧 만나거나, 막 알게 됐어요</small></span></label>
                    <label><input type="radio" name="stage" value="some" /><span><b>썸 타는 중</b><small>서로 호감은 있는데 아직 애매해요</small></span></label>
                    <label><input type="radio" name="stage" value="dating" /><span><b>연애 중</b><small>이미 사귀고 있어요</small></span></label>
                </div>
            </div>

            <button type="button" class="match-back" hidden>← 이전</button>
            <p class="match-privacy">입력한 이름은 저장하거나 보내지 않아요. 이 화면에서만 쓰여요.</p>
        </form>

        <div id="match-loading" class="match-card match-loading" hidden aria-live="polite">
            <div class="match-loading-heart" aria-hidden="true">♥</div>
            <p></p>
        </div>

        <section id="match-result" class="match-result" aria-live="polite" hidden></section>
    </main>
</div>

<script src="@Assets.Url("mbti-match-data.js")"></script>
<script src="@Assets.Url("mbti-match.js")"></script>

@code {
    private static readonly string[] Types =
    [
        "INTJ", "INTP", "ENTJ", "ENTP", "INFJ", "INFP", "ENFJ", "ENFP",
        "ISTJ", "ISFJ", "ESTJ", "ESFJ", "ISTP", "ISFP", "ESTP", "ESFP"
    ];

    private static RenderFragment TypeRadios(string name) => builder =>
    {
        var seq = 0;
        foreach (var t in Types)
        {
            builder.OpenElement(seq++, "label");
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "radio");
            builder.AddAttribute(seq++, "name", name);
            builder.AddAttribute(seq++, "value", t);
            builder.CloseElement();
            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, t);
            builder.CloseElement();
            builder.CloseElement();
        }
    };
}
