@page "/admin/site/password"
@layout Layout.SiteLayout
@attribute [Authorize(Roles = "SiteAdmin")]
@using Microsoft.AspNetCore.Authorization
@using RotationDating.Web.Services

<PageTitle>비밀번호 변경</PageTitle>

<div class="ssf-admin-page">
    <header class="page-header">
        <a href="/admin/site" class="back-link">← 홈페이지 관리</a>
        <p class="ssf-admin-eyebrow">SSF</p>
        <h1>비밀번호 변경</h1>
        <span class="ssf-accent-line" aria-hidden="true"></span>
        <p class="subtitle">SSF 관리자 비밀번호를 변경합니다</p>
    </header>

    @if (Saved)
    {
        <div class="alert-success">비밀번호가 변경되었습니다.</div>
    }
    @if (Error == "current")
    {
        <div class="error-text">현재 비밀번호가 올바르지 않습니다.</div>
    }
    @if (Error == "mismatch")
    {
        <div class="error-text">새 비밀번호가 서로 다릅니다.</div>
    }
    @if (Error == "short")
    {
        <div class="error-text">새 비밀번호는 4자 이상이어야 합니다.</div>
    }

    <form method="post" action="/admin/site/password" class="ssf-admin-panel">
        <label class="form-field">
            <span class="label">현재 비밀번호</span>
            <input type="password" name="currentPassword" class="input" autocomplete="current-password" required />
        </label>
        <label class="form-field">
            <span class="label">새 비밀번호</span>
            <input type="password" name="newPassword" class="input" autocomplete="new-password" minlength="4" required />
        </label>
        <label class="form-field">
            <span class="label">새 비밀번호 확인</span>
            <input type="password" name="confirmPassword" class="input" autocomplete="new-password" minlength="4" required />
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">변경</button>
            <a class="btn btn-secondary" href="/admin/site">취소</a>
        </div>
    </form>
</div>

@code {
    [SupplyParameterFromQuery] public bool Saved { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
