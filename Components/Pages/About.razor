@page "/about"
@layout Layout.SiteLayout
@using RotationDating.Web.Services
@inject SiteContentService SiteContent

<PageTitle>@_title</PageTitle>

<section class="ssf-about-page" id="about">
    <div class="ssf-container">
        <header class="ssf-page-intro">
            <p class="ssf-page-eyebrow">SSF</p>
            <h1 class="ssf-serif-heading">@_title</h1>
            <span class="ssf-accent-line ssf-accent-line-center" aria-hidden="true"></span>
        </header>

        @if (_site.AboutPeople.Count > 0)
        {
            <div class="ssf-about-stack">
                @{ var personIndex = 0; }
                @foreach (var person in _site.AboutPeople)
                {
                    var reversed = personIndex % 2 == 1;
                    personIndex++;
                    <AboutProfileBlock Title="@person.Title"
                                       Body="@person.Body"
                                       ImageUrl="@person.ImageUrl"
                                       Items="@person.Items"
                                       IsReversed="@reversed" />
                }
            </div>
        }
        else
        {
            <p class="ssf-about-empty">등록된 대표자 소개가 없습니다.</p>
        }
    </div>
</section>

@code {
    private SiteContentSnapshot _site = SiteContentSnapshot.Empty;
    private string _title = "About";

    protected override async Task OnInitializedAsync()
    {
        _site = await SiteContent.GetAsync();
        _title = _site.Get(SiteContentKeys.AboutTitle, "About");
    }
}
