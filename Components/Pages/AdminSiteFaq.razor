@page "/admin/site/faq"
@layout Layout.SiteLayout
@attribute [Authorize(Roles = "SiteAdmin")]
@using Microsoft.AspNetCore.Authorization
@using RotationDating.Web.Services
@inject SiteContentService SiteContent

<PageTitle>FAQ</PageTitle>

<div class="ssf-admin-page">
    <header class="page-header">
        <a href="/admin/site" class="back-link">← 홈페이지 관리</a>
        <p class="ssf-admin-eyebrow">SSF</p>
        <h1>FAQ</h1>
        <span class="ssf-accent-line" aria-hidden="true"></span>
        <p class="subtitle">자주 묻는 질문을 추가하고 수정합니다</p>
    </header>

    @if (Saved)
    {
        <div class="alert-success">저장되었습니다.</div>
    }
    @if (Deleted)
    {
        <div class="alert-success">삭제되었습니다.</div>
    }
    @if (Error == "empty")
    {
        <div class="error-text">질문과 답을 모두 입력해 주세요.</div>
    }

    @foreach (var item in _site.FaqItems)
    {
        <form method="post"
              action="/admin/site/faq/save"
              class="card form-card site-admin-item @(SavedId == item.Id ? "saved" : "")"
              id="item-@item.Id">
            <input type="hidden" name="id" value="@item.Id" />
            <div class="site-admin-item-head">
                <strong>Q @item.SortOrder</strong>
                <div class="site-admin-item-actions">
                    <button type="submit" formaction="/admin/site/faq/move" formnovalidate name="direction" value="up" class="btn btn-sm btn-secondary">위로</button>
                    <button type="submit" formaction="/admin/site/faq/move" formnovalidate name="direction" value="down" class="btn btn-sm btn-secondary">아래로</button>
                    <button type="submit" formaction="/admin/site/faq/delete" formnovalidate class="btn btn-sm btn-danger" onclick="return confirm('이 질문을 삭제할까요?');">삭제</button>
                </div>
            </div>
            <label class="form-field">
                <span class="label">질문</span>
                <input type="text" name="question" class="input" value="@item.Question" maxlength="300" required />
            </label>
            <label class="form-field">
                <span class="label">답변</span>
                <textarea name="answer" class="input textarea" rows="5" required>@item.Answer</textarea>
            </label>
            <button type="submit" class="btn btn-primary">이 질문 저장</button>
        </form>
    }

    <form method="post" action="/admin/site/faq/add" class="card form-card site-admin-item">
        <h2>질문 추가</h2>
        <label class="form-field">
            <span class="label">질문</span>
            <input type="text" name="question" class="input" maxlength="300" required />
        </label>
        <label class="form-field">
            <span class="label">답변</span>
            <textarea name="answer" class="input textarea" rows="5" required></textarea>
        </label>
        <button type="submit" class="btn btn-primary">추가</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery] public bool Saved { get; set; }
    [SupplyParameterFromQuery] public bool Deleted { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public int? Id { get; set; }

    private SiteContentSnapshot _site = SiteContentSnapshot.Empty;
    private int? SavedId => Saved ? Id : null;

    protected override async Task OnInitializedAsync()
    {
        _site = await SiteContent.GetAsync();
    }
}
