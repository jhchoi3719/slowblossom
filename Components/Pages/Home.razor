@page "/home"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using RotationDating.Web.Models
@using RotationDating.Web.Services

<PageTitle>메뉴</PageTitle>

<div class="page">
    @if (_venue is null)
    {
        <header class="page-header">
            <h1>행사 장소 선택</h1>
            <p class="subtitle">관리할 장소를 선택하세요</p>
        </header>

        <div class="venue-list">
            <a href="@VenueHelper.AdminHomeUrl(EventVenue.UnoCoffee)" class="venue-card venue-uno">
                <span class="venue-icon-badge tone-stone">
                    <svg class="menu-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 10h16v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-9Z" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg>
                </span>
                <div class="venue-text">
                    <span class="venue-title">우노커피</span>
                    <span class="venue-desc">날짜가 정해진 행사 · 신청서·투표·좌석</span>
                </div>
                <span class="menu-arrow">›</span>
            </a>

            <a href="@VenueHelper.AdminHomeUrl(EventVenue.HotelSuseongSquare)" class="venue-card venue-suseong">
                <span class="venue-icon-badge tone-blue">
                    <svg class="menu-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 20V8.5L12 4l8 4.5V20" />
                        <path d="M9 20v-6h6v6" />
                    </svg>
                </span>
                <div class="venue-text">
                    <span class="venue-title">호텔수성스퀘어</span>
                    <span class="venue-desc">여러 날 중 하루 확정 · 가능일 설문 신청</span>
                </div>
                <span class="menu-arrow">›</span>
            </a>
        </div>

        <div class="menu-list menu-list-spaced">
            <a href="/admin/mail-notify" class="menu-card">
                <span class="menu-icon-badge tone-teal">
                    <svg class="menu-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                        <path d="M10.3 21a1.8 1.8 0 0 0 3.4 0" />
                    </svg>
                </span>
                <div class="menu-text">
                    <span class="menu-title">신청 알림</span>
                    <span class="menu-desc">네이버폼 메일 → 텔레그램 알림</span>
                </div>
                <span class="menu-arrow">›</span>
            </a>
        </div>
    }
    else
    {
        <header class="page-header">
            <a href="/home" class="back-link">← 장소 선택</a>
            <h1>@VenueHelper.DisplayName(_venue.Value)</h1>
            <p class="subtitle">@VenueHelper.ShortDescription(_venue.Value)</p>
        </header>

        <div class="menu-list">
            <a href="@VenueHelper.AdminPageUrl("/applications", _venue.Value)" class="menu-card">
                <span class="menu-icon-badge tone-stone">
                    <svg class="menu-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="5" y="3.5" width="14" height="17" rx="2.5" />
                        <path d="M9 8.5h6M9 12.5h6M9 16.5h4" />
                    </svg>
                </span>
                <div class="menu-text">
                    <span class="menu-title">참가자 신청서</span>
                    <span class="menu-desc">신청서 확인 및 관리</span>
                </div>
                <span class="menu-arrow">›</span>
            </a>

            <a href="@VenueHelper.AdminPageUrl("/participants", _venue.Value)" class="menu-card">
                <span class="menu-icon-badge tone-blue">
                    <svg class="menu-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="9" cy="8" r="3" />
                        <circle cx="16.5" cy="9" r="2.4" />
                        <path d="M3.8 18.5c.7-2.8 2.8-4.2 5.2-4.2s4.5 1.4 5.2 4.2" />
                        <path d="M14.2 14.8c1.4-.5 3-.2 4.2 1.2.6.7 1 1.6 1.1 2.5" />
                    </svg>
                </span>
                <div class="menu-text">
                    <span class="menu-title">참가자 리스트</span>
                    <span class="menu-desc">확정된 참가자 목록</span>
                </div>
                <span class="menu-arrow">›</span>
            </a>

            @if (_venue == EventVenue.UnoCoffee)
            {
                <a href="@VenueHelper.AdminPageUrl("/vote-results/mid", _venue.Value)" class="menu-card">
                    <span class="menu-icon-badge tone-rose">
                        <svg class="menu-svg" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 20.4S4.8 15.6 4.8 10.2A3.9 3.9 0 0 1 12 7.5a3.9 3.9 0 0 1 7.2 2.7c0 5.4-7.2 10.2-7.2 10.2Z" />
                        </svg>
                    </span>
                    <div class="menu-text">
                        <span class="menu-title">중간투표 결과</span>
                        <span class="menu-desc">누가 누구를 선택했는지 확인</span>
                    </div>
                    <span class="menu-arrow">›</span>
                </a>
            }

            <a href="@VenueHelper.AdminPageUrl("/vote-results/final", _venue.Value)" class="menu-card">
                <span class="menu-icon-badge tone-rose">
                    <svg class="menu-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M8.2 4.8h7.6c1.2 0 2.2 1 2.2 2.2v7.4c0 .7-.3 1.3-.8 1.7L12 20.2 6.8 16.1a2.2 2.2 0 0 1-.8-1.7V7c0-1.2 1-2.2 2.2-2.2Z" />
                        <path d="M9.5 11.2h5M9.5 8.6h5M9.5 13.8h3.2" />
                    </svg>
                </span>
                <div class="menu-text">
                    <span class="menu-title">최종투표 결과</span>
                    <span class="menu-desc">최종 선택 결과 확인</span>
                </div>
                <span class="menu-arrow">›</span>
            </a>

            <a href="@VenueHelper.AdminPageUrl("/seating/initial", _venue.Value)" class="menu-card">
                <span class="menu-icon-badge tone-teal">
                    <svg class="menu-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3.5" y="8" width="7" height="7" rx="1.5" />
                        <rect x="13.5" y="8" width="7" height="7" rx="1.5" />
                        <path d="M10.5 11.5h3" />
                    </svg>
                </span>
                <div class="menu-text">
                    <span class="menu-title">초기 좌석 배치</span>
                    <span class="menu-desc">행사 시작 전 AI 1:1 좌석 매칭</span>
                </div>
                <span class="menu-arrow">›</span>
            </a>

            @if (_venue == EventVenue.UnoCoffee)
            {
                <a href="@VenueHelper.AdminPageUrl("/seating/mid", _venue.Value)" class="menu-card">
                    <span class="menu-icon-badge tone-teal">
                        <svg class="menu-svg" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3.5" y="8" width="7" height="7" rx="1.5" />
                            <rect x="13.5" y="8" width="7" height="7" rx="1.5" />
                            <path d="M10.5 11.5h3M12 5v3" />
                        </svg>
                    </span>
                    <div class="menu-text">
                        <span class="menu-title">중간투표 좌석 배치</span>
                        <span class="menu-desc">중간투표 결과 반영 1:1 좌석 매칭</span>
                    </div>
                    <span class="menu-arrow">›</span>
                </a>
            }

            <a href="@VenueHelper.AdminPageUrl("/admin/questions", _venue.Value)" class="menu-card">
                <span class="menu-icon-badge tone-blue">
                    <svg class="menu-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7.5 18.5 4.8 21v-3.2A7.7 7.7 0 0 1 4 13.2C4 8.4 7.8 4.8 12 4.8s8 3.6 8 8.4-3.8 8.4-8 8.4c-1.1 0-2.2-.2-3.2-.6" />
                        <path d="M9.8 10.2c.4-1.1 1.3-1.7 2.4-1.7 1.4 0 2.3.8 2.3 2 0 1.3-1.1 1.7-1.9 2.1-.7.4-1 .8-1 1.6M12 16.2h.01" />
                    </svg>
                </span>
                <div class="menu-text">
                    <span class="menu-title">질문카드</span>
                    <span class="menu-desc">대화 주제 목록·수정</span>
                </div>
                <span class="menu-arrow">›</span>
            </a>

            <a href="@VenueHelper.AdminPageUrl("/admin/consent", _venue.Value)" class="menu-card">
                <span class="menu-icon-badge tone-stone">
                    <svg class="menu-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M8 4.5h8a2 2 0 0 1 2 2v13l-6-2.5-6 2.5v-13a2 2 0 0 1 2-2Z" />
                        <path d="M9.5 10.5 11 12l3.5-3.5" />
                    </svg>
                </span>
                <div class="menu-text">
                    <span class="menu-title">참가자 동의</span>
                    <span class="menu-desc">동의 화면 사용 여부·문구 수정</span>
                </div>
                <span class="menu-arrow">›</span>
            </a>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "venue")]
    public string? Venue { get; set; }

    private EventVenue? _venue;

    protected override void OnParametersSet()
    {
        _venue = VenueHelper.TryParse(Venue);
    }
}
