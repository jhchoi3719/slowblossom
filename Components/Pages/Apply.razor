@page "/apply/{EventId:int}"
@layout Layout.SurveyLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Http
@using Microsoft.EntityFrameworkCore
@using RotationDating.Web.Services.ApplicationForm
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@(_event is null ? "참가 신청" : ApplicationNoticeDefaults.Title(_event))</PageTitle>

<div class="survey-public-page survey-take-page apply-page">
    @if (_event is null)
    {
        <div class="survey-public-card">
            <h1>신청서를 찾을 수 없습니다</h1>
            <p>링크가 올바른지 확인해 주세요.</p>
        </div>
    }
    else if (!_event.ApplyOpen)
    {
        <div class="survey-public-card survey-expired-card">
            <h1>신청이 마감되었습니다</h1>
            <p>다음 모임 소식은 인스타그램과 카카오톡 채널 '싱싱한팜'에서 안내드릴게요.</p>
        </div>
    }
    else
    {
        <div class="survey-take-wrap">
            <header class="survey-take-header apply-header">
                <h1>@ApplicationNoticeDefaults.Title(_event)</h1>
                <p class="subtitle">@_event.FormattedDate</p>
            </header>

            <section class="apply-notice">@ApplicationNoticeDefaults.Notice(_event)</section>

            @if (_errors.Count > 0)
            {
                <div class="error-text survey-take-error apply-errors">
                    <strong>아래 항목을 확인해 주세요.</strong>
                    <ul>
                        @foreach (var error in _errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                    @if (_draft is not null && !_draft.IsReturning)
                    {
                        <p>보안을 위해 첨부했던 사진은 다시 선택해 주세요.</p>
                    }
                </div>
            }

            <form method="post" action="/apply/@EventId/submit" enctype="multipart/form-data"
                  class="survey-take-form apply-form" id="apply-form">
                <input type="text" name="website" class="apply-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

                <div class="survey-take-list">
                    <article class="survey-take-item apply-returning">
                        <label class="survey-option-choice-row">
                            <input type="checkbox" name="isReturning" value="true" id="apply-returning"
                                   checked="@(_draft?.IsReturning == true)" />
                            <span><strong>기존 참가자예요</strong><br />이전에 참가하신 분은 사진·서류 없이 신청할 수 있어요.</span>
                        </label>
                    </article>

                    <article class="survey-take-item">
                        @Head(1, "이름 /생년월일", "실명/생년월일 8자리로 입력해주세요")
                        <div class="apply-two-col">
                            <input type="text" name="name" class="input" placeholder="홍길동" maxlength="50" required value="@_draft?.Name" />
                            <input type="text" name="birthDate" class="input" placeholder="19950219" maxlength="10"
                                   inputmode="numeric" required value="@_draft?.BirthDate" />
                        </div>
                    </article>

                    <article class="survey-take-item">
                        @Head(2, "성별", null)
                        @Choices("gender", [("남", "남자"), ("여", "여자")], _draft?.Gender)
                    </article>

                    <article class="survey-take-item">
                        @Head(3, "거주지", "현재 거주지를 동 단위까지 입력해 주세요.")
                        <input type="text" name="residence" class="input" placeholder="ex) 대구시 수성구 범어동" maxlength="100" required value="@_draft?.Residence" />
                    </article>

                    <article class="survey-take-item">
                        @Head(4, "연락처", "연락처를 입력해 주세요.")
                        <input type="tel" name="phone" class="input" placeholder="ex) 01012345678" maxlength="13"
                               inputmode="numeric" autocomplete="tel" required value="@_draft?.Phone" />
                    </article>

                    <article class="survey-take-item">
                        @Head(5, "카카오톡 ID", "행사 안내 및 참가자 연락을 위해 카카오톡 ID를 정확히 입력해 주세요.\n\n아래 경로에서 카카오톡 ID 확인 및 ‘ID 검색 허용’을 꼭 켜주시면 됩니다 🙂\n카카오톡 → 전체설정 → 내 프로필 우측 ‘관리’ → 카카오톡 ID → ‘ID 검색 허용’ 켬(ON)")
                        <input type="text" name="kakaoId" class="input" maxlength="50" required value="@_draft?.KakaoId" />
                    </article>

                    <article class="survey-take-item">
                        @Head(6, "최종학력", "최종학력 학교와 전공을 입력해 주세요.")
                        <input type="text" name="education" class="input" placeholder="ex) 경북대학교 경영학과" maxlength="100" required value="@_draft?.Education" />
                    </article>

                    <article class="survey-take-item">
                        @Head(7, "직장명, 부서, 직위", "현재 직장의 주소(동 단위 까지),명, 부서, 직위를 입력해 주세요.")
                        <input type="text" name="workplace" class="input" placeholder="ex) 대구 수성구 범어동, 대구은행, 인사과, 매니저" maxlength="200" required value="@_draft?.Workplace" />
                    </article>

                    @if (_event.Kind == EventKind.DatePoll && _event.CandidateDates.Count > 0)
                    {
                        <article class="survey-take-item">
                            <div class="survey-take-item-head">
                                <span class="survey-question-no">📅</span>
                                <div>
                                    <h2>참여 가능한 날짜 <span class="required-mark">*</span></h2>
                                    <p>가능한 날짜를 모두 선택해 주세요.</p>
                                </div>
                            </div>
                            <div class="survey-take-options">
                                @foreach (var candidate in _event.CandidateDates.OrderBy(c => c.SortOrder).ThenBy(c => c.EventDate))
                                {
                                    var value = candidate.EventDate.ToString("yyyy-MM-dd");
                                    <div class="survey-option-choice">
                                        <label class="survey-option-choice-row">
                                            <input type="checkbox" name="availableDates" value="@value"
                                                   checked="@(_draft?.AvailableDates.Any(d => d.Date == candidate.EventDate.Date) == true)" />
                                            <span>@candidate.EventDate.ToString("M월 d일 (ddd)")</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </article>
                    }

                    <article class="survey-take-item">
                        @Head(8, "원하는 상대 연령대", null)
                        @Choices("preferredAgeRange", ApplicationFormOptions.AgeRanges.Select(a => (a, a)).ToArray(), _draft?.PreferredAgeRange)
                    </article>

                    <article class="survey-take-item">
                        @Head(9, "관심사(복수선택)", "최대3가지 복수 선택 가능")
                        <div class="survey-take-options apply-interests" data-max="@ApplicationFormOptions.MaxInterests">
                            @foreach (var interest in ApplicationFormOptions.Interests)
                            {
                                <div class="survey-option-choice">
                                    <label class="survey-option-choice-row">
                                        <input type="checkbox" name="interests" value="@interest"
                                               checked="@(_draft?.Interests.Contains(interest) == true)" />
                                        <span>@interest</span>
                                    </label>
                                </div>
                            }
                        </div>
                        <p class="survey-take-hint">3개만 선택 가능</p>
                    </article>

                    <article class="survey-take-item">
                        @Head(10, "참여경로", null)
                        @Choices("referralSource", ApplicationFormOptions.ReferralSources.Select(r => (r, r)).ToArray(), _draft?.ReferralSource)
                    </article>

                    <article class="survey-take-item">
                        @Head(11, "신청동기", null)
                        <textarea name="motivation" class="input textarea" rows="3" maxlength="2000" required>@_draft?.Motivation</textarea>
                    </article>

                    <article class="survey-take-item">
                        @Head(12, "음주여부", null)
                        @Choices("drinking", [("true", "O"), ("false", "X")], OxValue(_draft?.Drinking))
                    </article>

                    <article class="survey-take-item">
                        @Head(13, "흡연 여부", null)
                        @Choices("smoking", [("true", "O"), ("false", "X")], OxValue(_draft?.Smoking))
                    </article>

                    <article class="survey-take-item">
                        @Head(14, "세줄 정도 자기소개", null)
                        <textarea name="selfIntro" class="input textarea" rows="4" maxlength="2000" required>@_draft?.SelfIntro</textarea>
                    </article>

                    <article class="survey-take-item apply-file-item">
                        @Head(15, "본인을 가장 잘 표현 할 수있는 사진 한장 첨부해주세요", "ex) 여행 중 찍은 사진, 일상 생활 속 찍은 사진, 특별한 사진이 없다면 증명 사진도 괜찮아요!\n단, 행사 참여 시 본인 확인이 가능한 사진으로 제출해주셔야 해요!")
                        @FileInput("photo")
                    </article>

                    <article class="survey-take-item apply-file-item">
                        @Head(16, "직장인 /사업자/대학(원)생 증", "우리는  증명 된 분들과의 만남만 하고 있어요.\nex) 명함, 재직증명서, 사원증, 사업자증명원,재학증명서 등 증명할 수 있는 서류")
                        @FileInput("employmentProof")
                    </article>

                    <article class="survey-take-item apply-file-item">
                        @Head(17, "혼인관계증명서", "해당 서류는 참가자분들 간의 신뢰 형성과 안전한 운영을 위한 최소한의 확인 절차이며,\n제출해주신 정보는 철저하게 비공개로 관리돼요.")
                        @FileInput("marriageCert")
                    </article>

                    <article class="survey-take-item">
                        @Head(18, "신청접수 및 진행", "본 행사는 신청서 접수 순으로 선정되지 않으며, 운영진 검토 후 최종 참가자를 선정하여 개별 연락드릴 예정입니다.\n\n선정되신 분들께는 행사일 기준 2주 이내 문자 또는 카카오톡으로 안내드릴 예정이며,\n미선정자분들께는 별도의 안내가 진행되지 않는 점 양해 부탁드립니다.")
                        @Agree("agreeSelection", "신청 및 선정 기준, 안내사항을 모두 확인하였고 이에 동의합니다.", _draft?.AgreeSelection)
                    </article>

                    <article class="survey-take-item">
                        @Head(19, "혼인관계증명 확인", "현재 법적으로 미혼 상태의 초혼임을 확인합니다.\n\n서로 안심하고 참여할 수 있는 자리 마련을 위해 간단한 확인 절차가 진행되는 점 부탁드립니다 🙏")
                        @Agree("agreeMarriage", "본인이 제출한 혼인관계증명서 내용에 이상이 없음을 확인하며, 현재 법적으로 미혼 상태의 초혼임을 확인합니다.", _draft?.AgreeMarriage)
                    </article>

                    <article class="survey-take-item">
                        @Head(20, "행사 진행 사진 촬영", "행사 진행 중 현장 사진 촬영이 진행될 수 있으며, 촬영된 사진은 SNS·블로그 등 행사 홍보 및 마케팅 목적으로 활용될 수 있습니다.\n\n다만, 모든 사진은 모자이크 및 블러 처리 후 사용되며 개인이 식별되지 않도록 안전하게 관리 및 활용될 예정입니다.")
                        @Agree("agreePhoto", "행사 중 사진 촬영 및 홍보 활용 안내 내용을 확인하였으며 이에 동의합니다.", _draft?.AgreePhoto)
                    </article>

                    <article class="survey-take-item">
                        @Head(21, "환불 규정 확인", "환불은 아래 규정 기준에 따라 진행되며, 원활한 행사 운영을 위해 개인 사정을 포함한 모든 경우에 동일한 기준이 적용됩니다.\n신청 전 환불 규정을 반드시 확인 부탁드립니다.\n\n• 신청 예약 당일 취소 : 100% 환불 가능\n• 행사일 기준 8일 전까지 취소 : 50% 공제 후 환불\n• 행사일 기준 7일 이내 취소 : 환불 불가")
                        @Agree("agreeRefund", "안내된 환불 규정을 확인하였으며, 개인 사유를 포함한 모든 경우에 동일 기준이 적용됨을 확인합니다.", _draft?.AgreeRefund)
                    </article>

                    <article class="survey-take-item">
                        @Head(22, "개인정보 수집 및 이용 동의", "동의하지 않을 경우, 설문 참여가 제한될 수 있습니다.\n\n수집 및 이용하는 개인정보 항목\n이름, 생년월일, 성별, 거주지, 휴대폰번호, 카카오톡 ID, 직장명ㆍ부서ㆍ직위, 직장주소, 최종학력, 사진(개인 식별이 어려운 행사 진행 사진), 제출 서류\n\n수집 및 이용 목적\n본인 확인, 행사 진행, 고객 관리 등\n\n보유 및 이용기간\n행사 진행 후 1년 보관")
                        @Agree("agreePrivacy", "동의합니다", _draft?.AgreePrivacy)
                    </article>
                </div>

                <div class="survey-take-footer">
                    <button type="submit" class="btn btn-primary survey-submit-btn" id="apply-submit">신청하기</button>
                </div>
            </form>
        </div>
    }
</div>

@code {
    [Parameter]
    public int EventId { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private Event? _event;
    private ApplicationFormInput? _draft;
    private List<string> _errors = [];

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _event = await db.Events.AsNoTracking()
            .Include(e => e.CandidateDates)
            .FirstOrDefaultAsync(e => e.Id == EventId);

        if (!string.IsNullOrEmpty(Error) && HttpContextAccessor.HttpContext is { } httpContext)
        {
            _draft = ApplicationDraftStore.LoadDraft(httpContext, EventId);
            _errors = Error == "duplicate"
                ? ["이미 신청하셨어요. 수정이 필요하면 카카오톡 채널로 연락 주세요."]
                : ApplicationDraftStore.LoadErrors(httpContext, EventId);
        }
    }

    private static string? OxValue(bool? value) => value switch
    {
        true => "true",
        false => "false",
        _ => null
    };

    private static RenderFragment Head(int no, string title, string? description) => @<div class="survey-take-item-head">
        <span class="survey-question-no">@no</span>
        <div>
            <h2>@title <span class="required-mark">*</span></h2>
            @if (!string.IsNullOrWhiteSpace(description))
            {
                <p class="apply-desc">@description</p>
            }
        </div>
    </div>;

    private static RenderFragment Choices(string name, (string Value, string Label)[] options, string? selected) => @<div class="survey-take-options">
        @foreach (var option in options)
        {
            <div class="survey-option-choice">
                <label class="survey-option-choice-row">
                    <input type="radio" name="@name" value="@option.Value" required checked="@(selected == option.Value)" />
                    <span>@option.Label</span>
                </label>
            </div>
        }
    </div>;

    private static RenderFragment Agree(string name, string label, bool? isChecked) => @<div class="survey-option-choice survey-consent-choice">
        <label class="survey-option-choice-row">
            <input type="checkbox" name="@name" value="true" required checked="@(isChecked == true)" />
            <span>@label</span>
        </label>
    </div>;

    private static RenderFragment FileInput(string name) => @<div class="apply-file">
        <input type="file" name="@name" accept="image/jpeg,image/png" class="input apply-file-input" data-compress required />
        <p class="survey-take-hint">jpg, jpeg, png · 1장 · 10MB 이하 <span class="apply-file-optional">(기존 참가자는 생략 가능)</span></p>
    </div>;
}
