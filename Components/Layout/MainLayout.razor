@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using RotationDating.Web.Services

<div class="app-shell">
    <AuthorizeView>
        <Authorized>
            <header class="top-bar">
                <span class="user-name">@context.User.Identity?.Name 님</span>
                @if (context.User.IsInRole(AuthRoles.Admin))
                {
                    <span class="admin-badge">관리자</span>
                }
                <form method="post" action="/logout" class="inline-form">
                    <button type="submit" class="btn btn-sm logout-btn">로그아웃</button>
                </form>
            </header>
        </Authorized>
    </AuthorizeView>

    <nav class="bottom-nav">
        <AuthorizeView Roles="Admin">
            <Authorized>
                <NavLink href="/home" class="nav-item" Match="NavLinkMatch.All">
                    <svg class="nav-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5.2v-6.2H10.2V21H5a1 1 0 0 1-1-1v-9.5Z" />
                    </svg>
                    <span class="nav-label">메뉴</span>
                </NavLink>
                <NavLink href="/admin/surveys" class="nav-item">
                    <svg class="nav-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="5" y="3.5" width="14" height="17" rx="2.5" />
                        <path d="M9 8.5h6M9 12.5h6M9 16.5h4" />
                    </svg>
                    <span class="nav-label">설문조사</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>

    <main class="main-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    오류가 발생했습니다.
    <a href="" class="reload">새로고침</a>
    <a class="dismiss">🗙</a>
</div>
