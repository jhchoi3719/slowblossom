@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using RotationDating.Web.Services

<div class="app-shell participant-shell">
    <AuthorizeView Roles="Participant">
        <Authorized>
            <header class="top-bar participant-top-bar">
                <span class="user-name">@context.User.Identity?.Name 님</span>
                <form method="post" action="/logout" class="inline-form">
                    <button type="submit" class="btn btn-sm logout-btn">로그아웃</button>
                </form>
            </header>
        </Authorized>
    </AuthorizeView>

    <main class="main-content participant-main">
        @Body
    </main>

    <nav class="bottom-nav participant-nav">
        <NavLink href="/welcome" class="nav-item" Match="NavLinkMatch.All">
            <svg class="nav-svg" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5.2v-6.2H10.2V21H5a1 1 0 0 1-1-1v-9.5Z" />
            </svg>
            <span class="nav-label">홈</span>
        </NavLink>
        <AuthorizeView Roles="Participant">
            <Authorized>
                @if (!IsHotelSuseongParticipant(context.User))
                {
                    <NavLink href="/vote/mid" class="nav-item">
                        <svg class="nav-svg" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 20.4S4.8 15.6 4.8 10.2A3.9 3.9 0 0 1 12 7.5a3.9 3.9 0 0 1 7.2 2.7c0 5.4-7.2 10.2-7.2 10.2Z" />
                        </svg>
                        <span class="nav-label">중간투표</span>
                    </NavLink>
                }
            </Authorized>
        </AuthorizeView>
        <NavLink href="/questions" class="nav-item">
            <svg class="nav-svg" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7.5 18.5 4.8 21v-3.2A7.7 7.7 0 0 1 4 13.2C4 8.4 7.8 4.8 12 4.8s8 3.6 8 8.4-3.8 8.4-8 8.4c-1.1 0-2.2-.2-3.2-.6" />
                <path d="M9.8 10.2c.4-1.1 1.3-1.7 2.4-1.7 1.4 0 2.3.8 2.3 2 0 1.3-1.1 1.7-1.9 2.1-.7.4-1 .8-1 1.6M12 16.2h.01" />
            </svg>
            <span class="nav-label">질문카드</span>
        </NavLink>
        <NavLink href="/vote/final" class="nav-item">
            <svg class="nav-svg" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8.2 4.8h7.6c1.2 0 2.2 1 2.2 2.2v7.4c0 .7-.3 1.3-.8 1.7L12 20.2 6.8 16.1a2.2 2.2 0 0 1-.8-1.7V7c0-1.2 1-2.2 2.2-2.2Z" />
                <path d="M9.5 11.2h5M9.5 8.6h5M9.5 13.8h3.2" />
            </svg>
            <span class="nav-label">최종투표</span>
        </NavLink>
    </nav>
</div>

@code {
    private static bool IsHotelSuseongParticipant(ClaimsPrincipal user) =>
        user.FindFirst(AuthClaims.VenueLabel)?.Value.Contains("호텔수성스퀘어", StringComparison.Ordinal) == true;
}
