@using RotationDating.Web.Services

<label class="form-field">
    <span class="label">@Label</span>
    @if (Urls.Count > 0)
    {
        <div class="site-admin-preview-row">
            @foreach (var url in Urls)
            {
                <img src="@url" alt="" class="site-admin-preview site-admin-preview-sm" />
            }
        </div>
    }
    <textarea name="@UrlFieldName"
              class="input site-admin-urls"
              rows="@Math.Clamp(Urls.Count + 1, 3, 10)"
              placeholder="이미지 주소를 한 줄에 하나씩">@string.Join('\n', Urls)</textarea>
    <input type="file"
           name="@FileFieldName"
           class="input"
           multiple
           accept="image/jpeg,image/png,image/webp,image/gif" />
    <p class="form-help">
        여러 장을 한 번에 선택할 수 있습니다. 대표 사진 다음 순서로 추가되며, 위 목록에서 줄을 지우면 그 사진은 빠집니다.
        JPG, PNG, WEBP, GIF · 각 8MB 이하
    </p>
</label>

@code {
    [Parameter] public string Label { get; set; } = "추가 사진 (슬라이드)";
    [Parameter] public string UrlFieldName { get; set; } = "extraImageUrls";
    [Parameter] public string FileFieldName { get; set; } = "extraImages";
    [Parameter] public IReadOnlyList<string> Urls { get; set; } = [];
}
