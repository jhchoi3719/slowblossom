<label class="form-field">
    <span class="label">@Label</span>
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl" alt="" class="site-admin-preview" />
    }
    <input type="text"
           name="@UrlFieldName"
           class="input"
           value="@ImageUrl"
           maxlength="1000"
           placeholder="이미지 주소 (선택)" />
    <input type="file"
           name="@FileFieldName"
           class="input"
           accept="image/jpeg,image/png,image/webp,image/gif" />
    <p class="form-help">파일을 올리거나 이미지 주소를 붙여넣으세요. JPG, PNG, WEBP, GIF · 8MB 이하</p>
</label>

@code {
    [Parameter] public string Label { get; set; } = "사진";
    [Parameter] public string UrlFieldName { get; set; } = "imageUrl";
    [Parameter] public string FileFieldName { get; set; } = "image";
    [Parameter] public string? ImageUrl { get; set; }
}
